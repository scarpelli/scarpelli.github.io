---
import BaseLayout from "../../layouts/BaseLayout.astro";
import PageHeader from "../../components/PageHeader.astro";
import ArticleRow from "../../components/ArticleRow.astro";
import { STR, withBase } from "../../data/strings";
import { t } from "../../data/i18n";
import { getArticles, articleSlug } from "../../data/content";

const articles = await getArticles();
const featured = articles.find((a) => a.data.featured) ?? articles[0];
const featuredHref = featured ? withBase(`articles/${articleSlug(featured)}`) : "#";
---

<BaseLayout title="Artigos · Bruna Scarpelli" current={0}>
  <PageHeader
    kicker={{ pt: STR.pt.kickerArticles, en: STR.en.kickerArticles }}
    title={{ pt: STR.pt.navFull[0], en: STR.en.navFull[0] }}
    intro={{ pt: STR.pt.pageIntro.articles, en: STR.en.pageIntro.articles }}
  />

  {
    featured && (
      <section class="section wrap reveal in" style="padding-top: clamp(32px,4vw,48px)">
        <span class="eyebrow" style="display:block;margin-bottom:18px">
          <Fragment set:html={t(STR.pt.latestLabel, STR.en.latestLabel)} />
        </span>
        <div class="feature">
          <div>
            <span class="eyebrow">
              <Fragment set:html={t(STR.pt.featLead, STR.en.featLead)} />
            </span>
            <h3>{featured.data.title}</h3>
            <p>{featured.data.summary}</p>
            <a class="readmore" href={featuredHref}>
              <Fragment set:html={t(STR.pt.readMore, STR.en.readMore)} /> <span class="arrow">→</span>
            </a>
          </div>
          <a href={featuredHref} class="ph" style="text-decoration:none">diagrama do pipeline</a>
        </div>
      </section>
    )
  }

  <section class="section wrap reveal" style="padding-top: 0">
    <div class="sec-head">
      <h2><Fragment set:html={t(STR.pt.secArticles, STR.en.secArticles)} /></h2>
    </div>
    <div class="jlist">
      {articles.map((a) => <ArticleRow article={a} />)}
    </div>
    {
      /* Estado vazio: visível só quando nenhum artigo do idioma ativo aparece.
         O site-client.ts alterna isto conforme o idioma. */
    }
    <p
      data-lang-empty
      style="font-family:Newsreader,serif;font-size:19px;color:var(--muted);padding:24px 0"
      hidden={articles.length > 0}
    >
      <Fragment set:html={t(STR.pt.emptyArticles, STR.en.emptyArticles)} />
    </p>
  </section>
</BaseLayout>
