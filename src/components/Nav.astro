---
import Band from "./Band.astro";
import { STR, GH_URL, LI_URL, NAV_HREFS, withBase } from "../data/strings";
import { GH_PATH, LI_PATH } from "../data/icons";
import { t } from "../data/i18n";

interface Props {
  // índice do item ativo: 0=Artigos, 1=Projetos, 2=Sobre, null=home
  current?: number | null;
}
const { current = null } = Astro.props;

// Rótulos bilíngues do nav (PT/EN) por índice.
const navLabels = STR.pt.navFull.map((pt, i) => ({ pt, en: STR.en.navFull[i] }));
---

<nav class="nav">
  <Band />
  <div class="nav-inner">
    <a class="nav-logo" href={withBase("")}>
      <span class="logo-mark">BS</span>
      <span>Bruna Scarpelli</span>
    </a>
    <div class="nav-links">
      {
        navLabels.map((label, i) => (
          <a href={NAV_HREFS[i]} class={current === i ? "active" : undefined}>
            <Fragment set:html={t(label.pt, label.en)} />
          </a>
        ))
      }
    </div>
    <div class="nav-right">
      <div class="lang">
        <button data-lang-btn="pt" class="on">🇧🇷 PT</button>
        <button data-lang-btn="en">🇺🇸 EN</button>
      </div>
      <div class="social">
        <a href={GH_URL} title="GitHub" target="_blank" rel="noopener">
          <svg width="19" height="19" viewBox="0 0 24 24" fill="currentColor"><path d={GH_PATH} /></svg>
        </a>
        <a href={LI_URL} title="LinkedIn" target="_blank" rel="noopener">
          <svg width="19" height="19" viewBox="0 0 24 24" fill="currentColor"><path d={LI_PATH} /></svg>
        </a>
      </div>
      <button class="nav-burger" data-burger aria-label="menu">
        <svg width="18" height="14" viewBox="0 0 18 14" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><path d="M1 1h16M1 7h16M1 13h16" /></svg>
      </button>
    </div>
  </div>
  <div class="mobile-menu" data-mobile-menu hidden>
    {
      navLabels.map((label, i) => (
        <a href={NAV_HREFS[i]} class={current === i ? "active" : undefined}>
          <Fragment set:html={t(label.pt, label.en)} />
        </a>
      ))
    }
    <div class="social" style="display:flex;gap:16px;margin-top:14px">
      <a href={GH_URL} target="_blank" rel="noopener">
        <svg width="19" height="19" viewBox="0 0 24 24" fill="currentColor"><path d={GH_PATH} /></svg>
      </a>
      <a href={LI_URL} target="_blank" rel="noopener">
        <svg width="19" height="19" viewBox="0 0 24 24" fill="currentColor"><path d={LI_PATH} /></svg>
      </a>
    </div>
  </div>
</nav>
